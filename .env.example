# ============================================================
#  NutriAI Tracker — настройки приложения
#  Скопируйте файл в .env и заполните AI_API_KEY:
#    cp .env.example .env        (Git Bash)
#    copy .env.example .env      (PowerShell)
# ============================================================

# --- Сервер ---
SECRET_KEY=change_me_to_a_random_64_char_hex_string
APP_TIMEZONE=Asia/Yekaterinburg
BACKEND_PORT=8001
DATABASE_URL=sqlite:///./data/nutriai.db
MEDIA_ROOT=./media
MAX_UPLOAD_MB=10

# --- ИИ (любой OpenAI-совместимый провайдер) ---
#
# Рекомендуемый вариант — Groq: бесплатно, быстро, поддерживает изображения.
# 1. Получите ключ: https://console.groq.com/keys
# 2. Вставьте его в AI_API_KEY (без кавычек и пробелов).
# 3. Перезапустите: docker compose up -d --force-recreate
# 4. Проверьте: http://localhost:8001/ai/check
#
# Модель ОБЯЗАТЕЛЬНО должна поддерживать изображения (vision).
# qwen/qwen3.8-27b — мультимодальная, ~1-2 секунды на фото.
#
# Альтернатива — OpenRouter (бесплатные vision-модели бывают медленными):
#   AI_BASE_URL=https://openrouter.ai/api/v1
#   AI_MODEL=nvidia/nemotron-3.5-super-vl:free
#   AI_TIMEOUT_SECONDS=60
#   Список моделей:
#     docker exec nutriaitracker-backend python scripts/list_openrouter_models.py
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=qwen/qwen3.8-27b
AI_TIMEOUT_SECONDS=30
AI_MAX_TOKENS=3000
AI_RECOMMENDATION_MAX_TOKENS=4000
AI_SITE_URL=http://localhost:8001
AI_APP_NAME=NutriAI Tracker
