# ============================================================
#  Эмулятор автомата перекусов — локальные настройки
#  Скопируйте в raspberry/.env и заполните данные пользователя.
# ============================================================

# Адрес backend. На компьютере — localhost, на Raspberry Pi — IP компьютера,
# где запущен Docker (например, http://192.168.1.10:8001).
NUTRIAI_API_URL=http://localhost:8001

# Пользователь, от имени которого работает автомат.
# Создайте его через /auth/register и заполните профиль и цель.
NUTRIAI_EMAIL=demo@example.com
NUTRIAI_PASSWORD=Passw0rd!123

# Либо готовый JWT. Если задан, email/пароль не нужны.
NUTRIAI_TOKEN=

# Идентификатор устройства, попадает в ответ /snack-check.
NUTRIAI_DEVICE_ID=snack-pi-01

# Позиция в автомате. Список доступных: GET /snacks.
NUTRIAI_SNACK_ID=1

# Таймаут HTTP-запроса в секундах. При таймауте автомат блокирует выдачу.
NUTRIAI_TIMEOUT=5

# virtual — только графическое окно; hardware — Raspberry Pi + gpiozero.
GPIO_MODE=virtual

# Пины GPIO (используются только при GPIO_MODE=hardware).
GPIO_GREEN_PIN=17
GPIO_RED_PIN=27
GPIO_SHUTTER_PIN=22
# Физическая кнопка (необязательно). Пусто — кнопка в GUI / Enter в headless.
GPIO_BUTTON_PIN=

# Положения сервопривода заслонки. Если на вашем сервоприводе
# направления инвертированы, поменяйте значения местами.
SHUTTER_OPEN_VALUE=1
SHUTTER_CLOSED_VALUE=0

# Сколько секунд заслонка остаётся открытой после разрешения.
SHUTTER_OPEN_SECONDS=4
